@baseUrl = https://miniapi-production-3e1bc0d9.up.railway.app/api
# These write examples change the Railway database. Use sample IDs carefully.

### Health check
GET {{baseUrl}}/health

### List products
GET {{baseUrl}}/products

### Filter products by category
GET {{baseUrl}}/products?category=home

### Get one product
GET {{baseUrl}}/products/1

### Create a product
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "description": "A keyboard for a comfortable workspace.",
  "price": 79.99,
  "category": "electronics",
  "stock": 15,
  "imageUrl": "https://example.com/keyboard.jpg"
}

### Update a product
PATCH {{baseUrl}}/products/1
Content-Type: application/json

{
  "price": 44.99,
  "stock": 20
}

### Delete a product
DELETE {{baseUrl}}/products/3

### List users
GET {{baseUrl}}/users

### Filter admin users
GET {{baseUrl}}/users?role=admin

### Create a user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Bob Student",
  "email": "bob@example.com"
}

### Update a user
PATCH {{baseUrl}}/users/1
Content-Type: application/json

{
  "isActive": false
}

### Delete a user
DELETE {{baseUrl}}/users/2
