{
  "openapi": "3.0.3",
  "info": {
    "title": "MiniShopStore API",
    "version": "1.0.0",
    "description": "Teaching-friendly NestJS API for products and users. Data is stored in PostgreSQL through Prisma."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health"
    },
    {
      "name": "Products",
      "description": "Product catalog operations"
    },
    {
      "name": "Users",
      "description": "Customer and admin user operations"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check service status",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List products",
        "parameters": [
          {
            "$ref": "#/components/parameters/Category"
          }
        ],
        "responses": {
          "200": {
            "description": "Product list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create a product",
        "security": [{"AdminApiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/products/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["Products"],
        "summary": "Get a product",
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Update a product",
        "security": [{"AdminApiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProduct"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete a product",
        "security": [{"AdminApiKey": []}],
        "responses": {
          "200": {
            "description": "Deleted product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "parameters": [
          {
            "$ref": "#/components/parameters/Role"
          }
        ],
        "responses": {
          "200": {
            "description": "User list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Register a customer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["Users"],
        "summary": "Get a user",
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update a user",
        "security": [{"AdminApiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user",
        "security": [{"AdminApiKey": []}],
        "responses": {
          "200": {
            "description": "Deleted user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AdminApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Use ADMIN_API_KEY. Local development fallback: local-teaching-key."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Category": {
        "name": "category",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Role": {
        "name": "role",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["customer", "admin"]
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed"
      },
      "Unauthorized": {
        "description": "Missing or invalid admin API key"
      },
      "NotFound": {
        "description": "Resource was not found"
      },
      "Conflict": {
        "description": "Email is already in use"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "timestamp"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "minishopstore-api"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": ["id", "name", "price", "category", "stock", "createdAt", "updatedAt"],
        "properties": {
          "id": {"type": "integer", "example": 1},
          "name": {"type": "string", "example": "Wireless Headphones"},
          "description": {"type": "string", "example": "Comfortable headphones for everyday listening."},
          "price": {"type": "number", "format": "double", "minimum": 0, "example": 49.99},
          "category": {"type": "string", "example": "electronics"},
          "stock": {"type": "integer", "minimum": 0, "example": 12},
          "imageUrl": {"type": "string", "format": "uri"},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      },
      "CreateProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "price", "category", "stock"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "description": {"type": "string", "maxLength": 500},
          "price": {"type": "number", "minimum": 0, "maximum": 1000000},
          "category": {"type": "string", "minLength": 2, "maxLength": 50},
          "stock": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "imageUrl": {"type": "string", "format": "uri"}
        }
      },
      "UpdateProduct": {
        "type": "object",
        "additionalProperties": false,
        "description": "Any subset of CreateProduct fields.",
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "description": {"type": "string", "maxLength": 500},
          "price": {"type": "number", "minimum": 0, "maximum": 1000000},
          "category": {"type": "string", "minLength": 2, "maxLength": 50},
          "stock": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "imageUrl": {"type": "string", "format": "uri"}
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role", "isActive", "createdAt", "updatedAt"],
        "properties": {
          "id": {"type": "integer", "example": 1},
          "name": {"type": "string", "example": "Alice Customer"},
          "email": {"type": "string", "format": "email", "example": "alice@example.com"},
          "role": {"type": "string", "enum": ["customer", "admin"]},
          "isActive": {"type": "boolean", "example": true},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      },
      "CreateUser": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "email": {"type": "string", "format": "email"}
        }
      },
      "UpdateUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "email": {"type": "string", "format": "email"},
          "role": {"type": "string", "enum": ["customer", "admin"]},
          "isActive": {"type": "boolean"}
        }
      }
    }
  }
}
